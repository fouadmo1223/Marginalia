---
const headline = ['Writing', 'worth', 'reading.'];
---

<section data-parallax-scope class="relative overflow-hidden border-b border-[var(--color-border)]">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div data-parallax="0.25" class="absolute -left-32 top-0 h-[520px] w-[520px] rounded-full opacity-40 blur-3xl" style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 70%);"></div>
    <div data-parallax="-0.18" class="absolute -right-24 top-24 h-[380px] w-[380px] rounded-full opacity-30 blur-3xl" style="background: radial-gradient(circle, color-mix(in srgb, var(--color-secondary) 30%, transparent), transparent 70%);"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 pb-14 pt-14 sm:px-8 sm:pt-20 lg:grid lg:grid-cols-12 lg:gap-8 lg:pb-0 lg:pt-24">
    <div class="lg:col-span-7 lg:pb-24">
      <div data-hero-fade class="mb-6 flex items-center gap-3">
        <span class="eyebrow">No. 01 &mdash; The Marginalia Journal</span>
        <span class="h-px flex-1 max-w-16 bg-[var(--color-border-strong)]"></span>
      </div>

      <h1 class="text-display text-[15vw] font-semibold text-[var(--color-ink)] sm:text-6xl lg:text-[5.2rem]">
        {headline.map((word, i) => (
          <span class="block overflow-hidden">
            <span data-hero-word class="block will-change-transform" style={i === 2 ? 'color: var(--color-accent);' : ''}>
              {word}
            </span>
          </span>
        ))}
      </h1>

      <div data-hero-fade class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-sm text-[var(--color-ink-soft)]">
          Marginalia is a home for independent writers — publish essays, follow people whose thinking you
          admire, and find your next favorite read.
        </p>

        <div class="flex shrink-0 items-center gap-6">
          <a href="/register" data-magnetic data-magnetic-strength="0.4" class="group relative overflow-hidden rounded-full bg-[var(--color-ink)] px-7 py-3 text-sm font-medium text-[var(--color-paper)] transition-transform hover:-translate-y-0.5">
            <span class="absolute inset-0 -translate-x-full bg-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-0"></span>
            <span class="relative">Start writing</span>
          </a>
          <a href="/explore" class="group flex items-center gap-1.5 text-sm font-medium text-[var(--color-ink)]">
            Browse stories
            <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>

    <div data-hero-fade class="relative mt-14 lg:col-span-5 lg:mt-0">
      <div data-parallax="-0.1" class="relative aspect-[4/5] w-full overflow-hidden rounded-sm lg:absolute lg:inset-y-8 lg:right-0 lg:aspect-auto">
        <div class="h-full w-full" style="background: linear-gradient(160deg, var(--color-primary) 0%, #1a2e30 55%, var(--color-secondary) 130%);"></div>
        <div class="absolute inset-0 opacity-60" aria-hidden="true">
          <div class="absolute left-10 top-14 h-44 w-44 rounded-full blur-3xl" style="background: color-mix(in srgb, var(--color-accent) 55%, transparent);"></div>
        </div>
        <div class="absolute inset-0 flex flex-col justify-between p-8">
          <span class="eyebrow text-white/70">Featured voice</span>
          <p class="font-serif text-3xl font-medium leading-[1.15] text-white">
            Essays, ideas, and the occasional argument worth having.
          </p>
        </div>
      </div>

      <div data-parallax="0.2" class="glass relative z-10 -mt-10 ml-4 w-52 rounded-sm p-4 shadow-xl lg:absolute lg:-bottom-6 lg:left-0 lg:mt-0 lg:ml-0">
        <p class="font-serif text-sm font-medium leading-snug text-[var(--color-ink)]">&ldquo;The room remembers before you do.&rdquo;</p>
        <p class="mt-2 text-[10px] uppercase tracking-wide text-[var(--color-ink-soft)]">Elena Marsh</p>
      </div>
    </div>
  </div>
</section>

<script src="../../scripts/hero-entrance.ts"></script>
<script src="../../scripts/parallax.ts"></script>
<script src="../../scripts/magnetic.ts"></script>
