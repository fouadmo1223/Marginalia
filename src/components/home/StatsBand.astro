---
interface Props {
  stats: { label: string; value: number }[];
}
const { stats } = Astro.props;
---

<section data-parallax-scope class="relative overflow-hidden border-b border-[var(--color-line)] bg-[var(--color-paper-raised)]/40">
  <div data-parallax="-0.15" class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[var(--color-accent-soft)] blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-5xl px-5 py-16 sm:px-8">
    <div data-reveal-strip class="grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
      {stats.map((s) => (
        <div>
          <p class="font-serif text-4xl font-semibold text-[var(--color-ink)] sm:text-5xl">
            <span data-countup data-target={s.value}>0</span>
          </p>
          <p class="mt-2 text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script src="../../scripts/stats-counter.ts"></script>
