---
interface Props {
  comments: {
    _id: unknown;
    content: string;
    createdAt: string | Date;
    author: { username: string; name: string; avatarUrl: string | null } | null;
    blog: { title: string; slug: string } | null;
  }[];
}
const { comments } = Astro.props;
---

{comments.length > 0 && (
  <section data-glass-spotlight class="relative overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-surface-raised)]">
    <div data-glass-layer class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <p data-reveal class="eyebrow mb-2">Community</p>
      <h2 data-reveal class="mb-8 font-serif text-2xl font-semibold text-[var(--color-ink-strong)]">What readers are saying</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {comments.map((c) => (
          <div data-reveal class="group relative overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <svg class="mb-2 h-5 w-5 text-[var(--color-accent)] opacity-50" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7.17 6.17A5.5 5.5 0 0 0 3 11.5V18h6.5v-6.5H5.6a3.5 3.5 0 0 1 2.9-3.45l-1.33-1.88Zm10 0A5.5 5.5 0 0 0 13 11.5V18h6.5v-6.5H15.6a3.5 3.5 0 0 1 2.9-3.45l-1.33-1.88Z" />
            </svg>
            <p class="text-sm leading-relaxed text-[var(--color-ink-strong)]">{c.content}</p>
            <div class="mt-4 flex items-center gap-2.5 border-t border-[var(--color-border)] pt-3.5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[var(--color-accent-soft)] text-[10px] font-semibold text-[var(--color-accent)]">
                {c.author?.avatarUrl ? <img src={c.author.avatarUrl} alt="" class="h-full w-full object-cover" /> : c.author?.name.charAt(0).toUpperCase()}
              </span>
              <div class="min-w-0">
                <p class="truncate text-xs font-semibold text-[var(--color-ink)]">{c.author?.name}</p>
                {c.blog && <a href={`/blog/${c.blog.slug}`} class="block truncate text-xs text-[var(--color-ink-soft)] hover:text-[var(--color-accent)]">on {c.blog.title}</a>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script src="../../scripts/glass-spotlight.ts"></script>
<script src="../../scripts/scroll-reveal.ts"></script>
