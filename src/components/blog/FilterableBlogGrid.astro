---
interface Props {
  blogs: {
    _id: unknown;
    title: string;
    slug: string;
    coverImage: { url: string } | null;
    likesCount: number;
    publishedAt: string | Date | null;
    createdAt: string | Date;
    author: { name: string } | null;
    categories: { name: string; slug: string }[];
  }[];
  categories: { name: string; slug: string }[];
}
const { blogs, categories } = Astro.props;

function timestamp(blog: (typeof blogs)[number]) {
  return new Date(blog.publishedAt ?? blog.createdAt).getTime();
}
---

<div data-filter-root>
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
      <label class="filter-pill">
        <input type="checkbox" id="filter-all" data-filter-all checked />
        <span>All</span>
      </label>
      {categories.map((c) => (
        <label class="filter-pill">
          <input type="checkbox" class="filter-cat" data-cat={c.slug} checked />
          <span>{c.name}</span>
        </label>
      ))}
    </div>

    <div class="flex items-center gap-2 text-sm">
      <span class="font-medium text-[var(--color-ink-soft)]">Sort:</span>
      <button data-sort="date" class="sort-btn" aria-pressed="true">Newest</button>
      <button data-sort="likes" class="sort-btn" aria-pressed="false">Most liked</button>
    </div>
  </div>

  <p data-filter-empty hidden class="rounded-lg border border-dashed border-[var(--color-line)] px-6 py-14 text-center text-sm text-[var(--color-ink-soft)]">
    No stories match these filters.
  </p>

  <div data-filter-grid class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {blogs.map((blog, i) => {
      const date = new Date(blog.publishedAt ?? blog.createdAt);
      return (
        <a
          href={`/blog/${blog.slug}`}
          data-reveal
          style={`transition-delay: ${Math.min(i, 5) * 50}ms`}
          class:list={['filter-item group block overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-[var(--color-border-strong)]', ...blog.categories.map((c) => `cat-${c.slug}`)]}
          data-item
          data-likes={blog.likesCount}
          data-date={timestamp(blog)}
        >
          <div class="relative aspect-[16/10] w-full overflow-hidden bg-[var(--color-paper-raised)]">
            {blog.coverImage ? (
              <img src={blog.coverImage.url} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" />
            ) : (
              <div class="flex h-full w-full items-center justify-center font-serif text-3xl text-[var(--color-ink-soft)]/40">{blog.title.charAt(0)}</div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/0 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            {blog.categories[0] && (
              <span class="absolute left-3 top-3 rounded-full bg-black/40 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-white backdrop-blur-md">
                {blog.categories[0].name}
              </span>
            )}
          </div>
          <div class="p-5">
            <h3 class="line-clamp-2 font-serif text-lg font-semibold leading-snug text-[var(--color-ink-strong)] transition-colors group-hover:text-[var(--color-accent)]">
              {blog.title}
            </h3>
            <div class="mt-4 flex items-center justify-between border-t border-[var(--color-border)] pt-3 text-xs text-[var(--color-ink-soft)]">
              <span class="flex min-w-0 items-center gap-1.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-soft)] text-[9px] font-bold text-[var(--color-accent)]">
                  {(blog.author?.name ?? '?').charAt(0).toUpperCase()}
                </span>
                <span class="truncate font-medium">{blog.author?.name ?? 'Unknown'}</span>
              </span>
              <span class="flex shrink-0 items-center gap-2.5">
                <time>{date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
                <span class="flex items-center gap-1">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-6.5-4.35-9.5-8.55C.63 9.9 1.3 6.1 4.6 4.7c2.02-.86 4.16-.13 5.4 1.5C11.24 4.57 13.38 3.84 15.4 4.7c3.3 1.4 3.97 5.2 2.1 7.75C18.5 16.65 12 21 12 21Z" /></svg>
                  {blog.likesCount}
                </span>
              </span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</div>

<style>
  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    cursor: pointer;
    user-select: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .filter-pill:has(input:checked) {
    border-color: var(--color-accent);
    color: var(--color-ink);
    background: var(--color-accent-soft);
  }
  .filter-pill input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .sort-btn {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }
  .sort-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-ink);
  }
  .sort-btn[aria-pressed='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }
</style>

<script src="../../scripts/blog-filter.ts"></script>
