---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  active: string;
}
const { title, active } = Astro.props;

const nav = [
  { key: 'overview', label: 'Overview', href: '/admin' },
  { key: 'homepage', label: 'Homepage', href: '/admin/homepage' },
  { key: 'users', label: 'Users', href: '/admin/users' },
  { key: 'blogs', label: 'Blogs', href: '/admin/blogs' },
  { key: 'comments', label: 'Comments', href: '/admin/comments' },
  { key: 'reports', label: 'Reports', href: '/admin/reports' },
  { key: 'categories', label: 'Categories', href: '/admin/categories' },
  { key: 'tags', label: 'Tags', href: '/admin/tags' },
  { key: 'media', label: 'Media', href: '/admin/media' },
  { key: 'settings', label: 'Settings', href: '/admin/settings' },
];
---

<BaseLayout title={`${title} · Admin`} noIndex>
  <div class="mx-auto max-w-7xl px-5 py-8 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-[200px_1fr]">
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <p class="mb-3 hidden text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-soft)] lg:block">Admin</p>
        <nav class="flex gap-1 overflow-x-auto pb-2 text-sm lg:flex-col lg:overflow-visible lg:pb-0">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'whitespace-nowrap rounded-lg px-3 py-2 lg:whitespace-normal',
                item.key === active
                  ? 'bg-[var(--color-ink)] text-[var(--color-paper)]'
                  : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-paper-raised)] hover:text-[var(--color-ink)]',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </aside>
      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
