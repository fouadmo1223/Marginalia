---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { connectToDatabase } from '../../../lib/db';
import { User } from '../../../models/User';
import { Follow } from '../../../models/Follow';

const { username } = Astro.params;
await connectToDatabase();
const profileUser = await User.findOne({ usernameLower: username?.toLowerCase() }).lean();
if (!profileUser) return Astro.redirect('/404');

const follows = await Follow.find({ follower: profileUser._id })
  .sort({ createdAt: -1 })
  .populate('following', 'username name avatarUrl bio')
  .lean();
---

<BaseLayout title={`People ${profileUser.name} follows`} noIndex>
  <div class="mx-auto max-w-lg px-5 py-12 sm:px-8">
    <a href={`/profile/${profileUser.username}`} class="text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]">&larr; Back to profile</a>
    <h1 class="mt-3 font-serif text-2xl font-semibold text-[var(--color-ink)]">Following</h1>
    {follows.length === 0 && <p class="mt-8 text-sm text-[var(--color-ink-soft)]">Not following anyone yet.</p>}
    <ul class="mt-6 space-y-4">
      {follows.map((f: any) => (
        <li>
          <a href={`/profile/${f.following.username}`} class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-[var(--color-paper-raised)] text-sm font-medium">
              {f.following.avatarUrl ? <img src={f.following.avatarUrl} alt="" class="h-full w-full object-cover" /> : f.following.name.charAt(0).toUpperCase()}
            </span>
            <span>
              <span class="block text-sm font-medium text-[var(--color-ink)]">{f.following.name}</span>
              <span class="block text-xs text-[var(--color-ink-soft)]">@{f.following.username}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
