---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noIndex>
  <div class="mx-auto flex min-h-[calc(100vh-8rem)] max-w-md flex-col items-center justify-center px-5 text-center">
    <p class="font-serif text-6xl font-semibold text-[var(--color-ink)]">404</p>
    <h1 class="mt-3 font-serif text-2xl font-semibold text-[var(--color-ink)]">Page not found</h1>
    <p class="mt-2 text-sm text-[var(--color-ink-soft)]">The page you're looking for doesn't exist or may have been moved.</p>
    <a href="/" class="mt-6 rounded-full bg-[var(--color-ink)] px-5 py-2 text-sm font-medium text-[var(--color-paper)] hover:bg-[var(--color-accent)]">
      Back to home
    </a>
  </div>
</BaseLayout>
