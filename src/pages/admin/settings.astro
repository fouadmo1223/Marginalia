---
import AdminShell from '../../layouts/AdminShell.astro';
import { connectToDatabase } from '../../lib/db';
import { User } from '../../models/User';

await connectToDatabase();
const admins = await User.find({ role: 'admin' }).select('username name email createdAt').lean();

const integrations = [
  { name: 'MongoDB', configured: Boolean(process.env.MONGODB_URI) },
  { name: 'Google OAuth', configured: Boolean(process.env.GOOGLE_CLIENT_ID && process.env.GOOGLE_CLIENT_SECRET) },
  { name: 'Cloudinary', configured: Boolean(process.env.CLOUDINARY_CLOUD_NAME && process.env.CLOUDINARY_API_SECRET) },
  { name: 'SMTP email', configured: Boolean(process.env.SMTP_HOST) },
];
---

<AdminShell title="Settings" active="settings">
  <h1 class="mb-6 font-serif text-2xl font-semibold text-[var(--color-ink)]">Settings</h1>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-lg border border-[var(--color-line)] bg-white p-5">
      <h2 class="mb-3 font-serif text-lg font-semibold text-[var(--color-ink)]">Integrations</h2>
      <ul class="divide-y divide-[var(--color-line)]">
        {integrations.map((i) => (
          <li class="flex items-center justify-between py-2.5 text-sm">
            <span class="text-[var(--color-ink)]">{i.name}</span>
            <span class:list={['rounded-full px-2.5 py-0.5 text-xs', i.configured ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700']}>
              {i.configured ? 'Configured' : 'Missing'}
            </span>
          </li>
        ))}
      </ul>
      {integrations.some((i) => !i.configured) && (
        <p class="mt-3 text-xs text-[var(--color-ink-soft)]">Set missing values in your environment configuration (.env) before deploying.</p>
      )}
    </section>

    <section class="rounded-lg border border-[var(--color-line)] bg-white p-5">
      <h2 class="mb-3 font-serif text-lg font-semibold text-[var(--color-ink)]">Administrators</h2>
      <ul class="divide-y divide-[var(--color-line)]">
        {admins.map((a) => (
          <li class="py-2.5 text-sm">
            <p class="text-[var(--color-ink)]">{a.name} <span class="text-[var(--color-ink-soft)]">@{a.username}</span></p>
            <p class="text-xs text-[var(--color-ink-soft)]">{a.email}</p>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-[var(--color-ink-soft)]">Manage roles from the Users section.</p>
    </section>
  </div>
</AdminShell>
