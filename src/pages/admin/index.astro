---
import AdminShell from '../../layouts/AdminShell.astro';
import MiniBarChart from '../../components/admin/MiniBarChart.astro';
import { connectToDatabase } from '../../lib/db';
import { User } from '../../models/User';
import { Blog } from '../../models/Blog';
import { Comment } from '../../models/Comment';
import { Like } from '../../models/Like';
import { Report } from '../../models/Report';

await connectToDatabase();
const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

const [
  totalUsers,
  newUsers,
  activeUsers,
  totalBlogs,
  publishedBlogs,
  draftBlogs,
  totalComments,
  totalLikes,
  viewsAgg,
  pendingReports,
  signupsByDay,
  blogsByDay,
] = await Promise.all([
  User.countDocuments(),
  User.countDocuments({ createdAt: { $gte: thirtyDaysAgo } }),
  User.countDocuments({ updatedAt: { $gte: sevenDaysAgo }, status: 'active' }),
  Blog.countDocuments(),
  Blog.countDocuments({ status: 'published' }),
  Blog.countDocuments({ status: 'draft' }),
  Comment.countDocuments({ deleted: false }),
  Like.countDocuments(),
  Blog.aggregate([{ $group: { _id: null, total: { $sum: '$viewsCount' } } }]),
  Report.countDocuments({ status: 'PENDING' }),
  User.aggregate([
    { $match: { createdAt: { $gte: thirtyDaysAgo } } },
    { $group: { _id: { $dateToString: { format: '%m/%d', date: '$createdAt' } }, count: { $sum: 1 } } },
    { $sort: { _id: 1 } },
  ]),
  Blog.aggregate([
    { $match: { createdAt: { $gte: thirtyDaysAgo } } },
    { $group: { _id: { $dateToString: { format: '%m/%d', date: '$createdAt' } }, count: { $sum: 1 } } },
    { $sort: { _id: 1 } },
  ]),
]);

const stats = [
  { label: 'Total users', value: totalUsers, color: 'var(--color-primary)', soft: 'color-mix(in srgb, var(--color-primary) 14%, transparent)', icon: 'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z' },
  { label: 'Active users (7d)', value: activeUsers, color: 'var(--color-success)', soft: 'var(--color-success-soft)', icon: 'M3.75 13.5l6-6 4 4 7.5-7.5M21.25 4v5.25H16' },
  { label: 'New users (30d)', value: newUsers, color: 'var(--color-info)', soft: 'var(--color-info-soft)', icon: 'M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.125 3.125 0 1 1-6.25 0 3.125 3.125 0 0 1 6.25 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z' },
  { label: 'Total blogs', value: totalBlogs, color: 'var(--color-accent)', soft: 'var(--color-accent-soft)', icon: 'M4 5.5A2.5 2.5 0 0 1 6.5 3H18a1 1 0 0 1 1 1v15.5a.5.5 0 0 1-.79.407L15 17.5H6.5A2.5 2.5 0 0 1 4 15V5.5Z' },
  { label: 'Published blogs', value: publishedBlogs, color: 'var(--color-success)', soft: 'var(--color-success-soft)', icon: 'M5 13l4 4L19 7' },
  { label: 'Draft blogs', value: draftBlogs, color: 'var(--color-warning)', soft: 'var(--color-warning-soft)', icon: 'M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z' },
  { label: 'Total comments', value: totalComments, color: 'var(--color-secondary)', soft: 'color-mix(in srgb, var(--color-secondary) 16%, transparent)', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z' },
  { label: 'Total likes', value: totalLikes, color: 'var(--color-accent2)', soft: 'var(--color-accent2-soft)', icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z' },
  { label: 'Total views', value: viewsAgg[0]?.total ?? 0, color: 'var(--color-info)', soft: 'var(--color-info-soft)', icon: 'M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z' },
];
---

<AdminShell title="Overview" active="overview">
  <div class="mb-6 flex items-center justify-between stagger-in" style="--stagger-i: 0">
    <h1 class="font-serif text-2xl font-semibold text-[var(--color-ink-strong)]">Overview</h1>
    {pendingReports > 0 && (
      <a href="/admin/reports" class="rounded-full bg-[var(--color-warning-soft)] px-4 py-1.5 text-sm font-medium text-[var(--color-warning)] transition-transform hover:-translate-y-px">
        {pendingReports} pending report{pendingReports === 1 ? '' : 's'}
      </a>
    )}
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
    {stats.map((s, i) => (
      <div
        class="stagger-in group relative overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
        style={`--stagger-i: ${i + 1}; box-shadow: 0 1px 2px color-mix(in srgb, var(--color-ink) 4%, transparent);`}
      >
        <div
          class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 rounded-full opacity-70 blur-2xl transition-opacity duration-300 group-hover:opacity-100"
          style={`background: ${s.soft};`}
          aria-hidden="true"
        ></div>
        <div class="relative mb-3 flex h-9 w-9 items-center justify-center rounded-lg" style={`background: ${s.soft}; color: ${s.color};`}>
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d={s.icon} />
          </svg>
        </div>
        <p class="relative font-serif text-2xl font-semibold tabular-nums" style={`color: ${s.color};`}>{s.value.toLocaleString()}</p>
        <p class="relative mt-1 text-xs font-medium text-[var(--color-ink-soft)]">{s.label}</p>
      </div>
    ))}
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="stagger-in" style={`--stagger-i: ${stats.length + 1}`}>
      <MiniBarChart data={signupsByDay} label="New signups (last 30 days)" color="var(--color-primary)" />
    </div>
    <div class="stagger-in" style={`--stagger-i: ${stats.length + 2}`}>
      <MiniBarChart data={blogsByDay} label="Blogs created (last 30 days)" color="var(--color-accent)" />
    </div>
  </div>
</AdminShell>
