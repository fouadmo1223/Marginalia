---
import DashboardShell from '../../layouts/DashboardShell.astro';
import { connectToDatabase } from '../../lib/db';
import { Blog } from '../../models/Blog';
import { Comment } from '../../models/Comment';

const user = Astro.locals.user!;
await connectToDatabase();

const [totalBlogs, publishedBlogs, draftBlogs, viewsAgg, likesAgg, commentsCount] = await Promise.all([
  Blog.countDocuments({ author: user._id }),
  Blog.countDocuments({ author: user._id, status: 'published' }),
  Blog.countDocuments({ author: user._id, status: 'draft' }),
  Blog.aggregate([{ $match: { author: user._id } }, { $group: { _id: null, total: { $sum: '$viewsCount' } } }]),
  Blog.aggregate([{ $match: { author: user._id } }, { $group: { _id: null, total: { $sum: '$likesCount' } } }]),
  Comment.countDocuments({ author: user._id, deleted: false }),
]);

const recentBlogs = await Blog.find({ author: user._id }).sort({ updatedAt: -1 }).limit(5).lean();

const stats = [
  {
    label: 'Total blogs',
    value: totalBlogs,
    color: 'var(--color-primary)',
    soft: 'color-mix(in srgb, var(--color-primary) 14%, transparent)',
    icon: 'M4 5.5A2.5 2.5 0 0 1 6.5 3H18a1 1 0 0 1 1 1v15.5a.5.5 0 0 1-.79.407L15 17.5H6.5A2.5 2.5 0 0 1 4 15V5.5Z',
  },
  {
    label: 'Published',
    value: publishedBlogs,
    color: 'var(--color-success)',
    soft: 'var(--color-success-soft)',
    icon: 'M5 13l4 4L19 7',
  },
  {
    label: 'Drafts',
    value: draftBlogs,
    color: 'var(--color-warning)',
    soft: 'var(--color-warning-soft)',
    icon: 'M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z',
  },
  {
    label: 'Total views',
    value: viewsAgg[0]?.total ?? 0,
    color: 'var(--color-info)',
    soft: 'var(--color-info-soft)',
    icon: 'M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  },
  {
    label: 'Total likes',
    value: likesAgg[0]?.total ?? 0,
    color: 'var(--color-accent2)',
    soft: 'var(--color-accent2-soft)',
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z',
  },
  {
    label: 'Comments',
    value: commentsCount,
    color: 'var(--color-accent)',
    soft: 'var(--color-accent-soft)',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z',
  },
];
---

<DashboardShell title="Dashboard" active="overview">
  <h1 class="font-serif text-2xl font-semibold text-[var(--color-ink)]">Welcome back, {user.name.split(' ')[0]}</h1>

  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {stats.map((s) => (
      <div
        class="group relative overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
        style={`box-shadow: 0 1px 2px color-mix(in srgb, var(--color-ink) 4%, transparent);`}
      >
        <div
          class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 rounded-full opacity-70 blur-2xl transition-opacity duration-300 group-hover:opacity-100"
          style={`background: ${s.soft};`}
          aria-hidden="true"
        ></div>
        <div
          class="relative mb-3 flex h-9 w-9 items-center justify-center rounded-lg"
          style={`background: ${s.soft}; color: ${s.color};`}
        >
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d={s.icon} />
          </svg>
        </div>
        <p class="relative font-serif text-3xl font-semibold tabular-nums" style={`color: ${s.color};`}>{s.value.toLocaleString()}</p>
        <p class="relative mt-1 text-xs font-medium text-[var(--color-ink-soft)]">{s.label}</p>
      </div>
    ))}
  </div>

  <div class="mt-10">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="font-serif text-lg font-semibold text-[var(--color-ink)]">Recent activity</h2>
      <a href="/dashboard/blogs" class="text-sm text-[var(--color-accent)] hover:underline">View all</a>
    </div>
    {recentBlogs.length === 0 ? (
      <div class="rounded-lg border border-dashed border-[var(--color-line)] px-6 py-12 text-center">
        <p class="text-sm text-[var(--color-ink-soft)]">You haven't written anything yet.</p>
        <a href="/dashboard/create" class="mt-4 inline-block rounded-full bg-[var(--color-ink)] px-5 py-2 text-sm font-medium text-[var(--color-paper)]">
          Write your first blog
        </a>
      </div>
    ) : (
      <ul class="divide-y divide-[var(--color-line)] rounded-lg border border-[var(--color-line)] bg-white">
        {recentBlogs.map((b) => (
          <li class="flex items-center justify-between px-4 py-3">
            <div class="min-w-0">
              <a href={`/dashboard/edit/${b._id}`} class="truncate text-sm font-medium text-[var(--color-ink)] hover:text-[var(--color-accent)]">{b.title}</a>
              <p class="text-xs text-[var(--color-ink-soft)]">{b.status} &middot; {b.likesCount} likes &middot; {b.commentsCount} comments</p>
            </div>
            <span class:list={['rounded-full px-2.5 py-0.5 text-xs', b.status === 'published' ? 'bg-green-50 text-green-700' : 'bg-amber-50 text-amber-700']}>
              {b.status}
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</DashboardShell>
