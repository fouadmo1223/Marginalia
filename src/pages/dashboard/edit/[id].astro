---
import DashboardShell from '../../../layouts/DashboardShell.astro';
import BlogEditor from '../../../components/dashboard/BlogEditor';
import { connectToDatabase } from '../../../lib/db';
import { Blog } from '../../../models/Blog';
import { Category } from '../../../models/Category';

const user = Astro.locals.user!;
const { id } = Astro.params;

await connectToDatabase();
const blog = await Blog.findById(id).populate('tags', 'name').lean();
if (!blog) return Astro.redirect('/dashboard/blogs');

const isOwner = String(blog.author) === String(user._id);
if (!isOwner && user.role !== 'admin') return Astro.redirect('/403');

const categories = await Category.find().sort({ order: 1 }).lean();
---

<DashboardShell title="Edit blog" active="blogs">
  <BlogEditor
    client:load
    categories={categories.map((c) => ({ _id: String(c._id), name: c.name }))}
    initial={{
      _id: String(blog._id),
      title: blog.title,
      excerpt: blog.excerpt,
      content: blog.content,
      status: blog.status,
      coverImage: blog.coverImage,
      categories: (blog.categories as any[]).map((c) => String(c)),
      tags: (blog.tags as any[]).map((t) => t.name),
      slug: blog.slug,
    }}
  />
</DashboardShell>
