---
import DashboardShell from '../../layouts/DashboardShell.astro';
import { connectToDatabase } from '../../lib/db';
import { Comment } from '../../models/Comment';

const user = Astro.locals.user!;
await connectToDatabase();

const comments = await Comment.find({ author: user._id, deleted: false })
  .sort({ createdAt: -1 })
  .limit(50)
  .populate('blog', 'title slug')
  .lean();
---

<DashboardShell title="My Comments" active="comments">
  <h1 class="mb-6 font-serif text-2xl font-semibold text-[var(--color-ink)]">Comments</h1>
  {comments.length === 0 ? (
    <div class="rounded-lg border border-dashed border-[var(--color-line)] px-6 py-14 text-center">
      <p class="text-sm text-[var(--color-ink-soft)]">You haven't commented on anything yet.</p>
    </div>
  ) : (
    <ul class="divide-y divide-[var(--color-line)] rounded-lg border border-[var(--color-line)] bg-white">
      {comments.map((c: any) => (
        <li class="px-4 py-4">
          <a href={`/blog/${c.blog?.slug}`} class="text-xs text-[var(--color-ink-soft)] hover:text-[var(--color-accent)]">{c.blog?.title}</a>
          <p class="mt-1 text-sm text-[var(--color-ink)]">{c.content}</p>
        </li>
      ))}
    </ul>
  )}
</DashboardShell>
