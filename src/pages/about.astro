---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/about/Timeline.astro';
import ValuesGrid from '../components/about/ValuesGrid';
import { connectToDatabase } from '../lib/db';
import { User } from '../models/User';
import { Blog } from '../models/Blog';
import { Comment } from '../models/Comment';

await connectToDatabase();
const [totalWriters, totalStories, likesAgg, totalComments] = await Promise.all([
  User.countDocuments({ status: 'active' }),
  Blog.countDocuments({ status: 'published' }),
  Blog.aggregate([{ $match: { status: 'published' } }, { $group: { _id: null, total: { $sum: '$likesCount' } } }]),
  Comment.countDocuments({ deleted: false }),
]);
const stats = [
  { label: 'Writers', value: totalWriters },
  { label: 'Stories published', value: totalStories },
  { label: 'Likes given', value: likesAgg[0]?.total ?? 0 },
  { label: 'Comments', value: totalComments },
];

const user = Astro.locals.user;
---

<BaseLayout title="About" description="Why Marginalia exists, and what it's built on.">
  <!-- 1. Hero — split, image right -->
  <section class="border-b border-[var(--color-border)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:py-28">
      <div>
        <p data-reveal class="eyebrow mb-4">About Marginalia</p>
        <h1 data-reveal class="font-serif text-4xl font-semibold leading-tight text-[var(--color-ink-strong)] sm:text-5xl">
          A place to write, without the platform getting in the way.
        </h1>
        <p data-reveal class="mt-5 max-w-lg text-lg text-[var(--color-ink-soft)]">
          No algorithm deciding who reads you. No ads between paragraphs. Just writers, readers, and the words in between.
        </p>
      </div>
      <div data-reveal-image class="relative aspect-[4/5] overflow-hidden rounded-2xl shadow-xl">
        <img src="https://picsum.photos/seed/marginalia-about-hero/900/1100" alt="A deer at sunrise in a quiet forest clearing" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- 2. Behind the scenes — three-photo strip -->
  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface-raised)]">
    <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8">
      <div class="mb-10 max-w-lg">
        <p data-reveal class="eyebrow mb-2">Behind the scenes</p>
        <h2 data-reveal class="font-serif text-3xl font-semibold text-[var(--color-ink-strong)]">Made by people who write here too</h2>
        <p data-reveal class="mt-3 text-[var(--color-ink-soft)]">Every person on this team publishes on Marginalia — we build for ourselves first.</p>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div data-reveal class="col-span-2 row-span-2 aspect-[4/3] overflow-hidden rounded-2xl">
          <img src="https://picsum.photos/seed/marginalia-scene-1/900/700" alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-105" />
        </div>
        <div data-reveal class="aspect-square overflow-hidden rounded-2xl">
          <img src="https://picsum.photos/seed/marginalia-scene-2/500/500" alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-105" />
        </div>
        <div data-reveal class="aspect-square overflow-hidden rounded-2xl">
          <img src="https://picsum.photos/seed/marginalia-scene-3/500/500" alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-105" />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Story / timeline (unchanged) -->
  <section class="border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-5 py-20 sm:px-8">
      <div class="mb-12 text-center">
        <p data-reveal class="eyebrow mb-2 justify-center">How we got here</p>
        <h2 data-reveal class="font-serif text-3xl font-semibold text-[var(--color-ink-strong)]">A short history</h2>
      </div>
      <Timeline />
    </div>
  </section>

  <!-- 4. Values, paired with an image -->
  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface-raised)]">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div data-reveal-image class="relative aspect-[3/4] overflow-hidden rounded-2xl shadow-lg">
        <img src="https://picsum.photos/seed/pine-forest-green/700/900" alt="Tulips in a sunlit pine forest" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
      </div>
      <div>
        <p data-reveal class="eyebrow mb-2">What we won't compromise on</p>
        <h2 data-reveal class="mb-8 font-serif text-3xl font-semibold text-[var(--color-ink-strong)]">Four decisions, made once</h2>
        <ValuesGrid client:visible />
      </div>
    </div>
  </section>

  <!-- 5. In their words — portrait + quote -->
  <section class="border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-8">
      <div data-reveal class="mx-auto mb-6 h-20 w-20 overflow-hidden rounded-full ring-4 ring-[var(--color-accent-soft)]">
        <img src="https://picsum.photos/seed/marginalia-founder/200/200" alt="" class="h-full w-full object-cover" />
      </div>
      <p data-reveal class="font-serif text-2xl font-medium leading-snug text-[var(--color-ink-strong)] sm:text-3xl">
        &ldquo;We built the platform we wanted to write on — one that gets out of the way and lets a sentence be the whole point.&rdquo;
      </p>
      <p data-reveal class="mt-4 text-sm font-medium text-[var(--color-ink-soft)]">The Marginalia team</p>
    </div>
  </section>

  <!-- 6. CTA — nature image background -->
  <section class="relative overflow-hidden">
    <img src="https://picsum.photos/seed/calm-lake-trees/1600/700" alt="A calm lake between mountains" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[var(--color-inverse-bg)]/80"></div>
    <div class="relative mx-auto max-w-2xl px-5 py-24 text-center sm:px-8">
      <h2 data-reveal class="font-serif text-3xl font-semibold text-[var(--color-inverse-text)] sm:text-4xl">
        {user ? 'Your next story is waiting to be written.' : 'Come write with us.'}
      </h2>
      <p data-reveal class="mx-auto mt-4 max-w-md text-[var(--color-inverse-text-soft)]">
        {user ? 'Pick up where you left off, or start something new.' : 'Join a platform built for writers first.'}
      </p>
      <a
        data-reveal
        href={user ? '/dashboard/create' : '/register'}
        class="mt-8 inline-block rounded-full bg-[var(--color-inverse-text)] px-7 py-3 text-sm font-semibold text-[var(--color-inverse-bg)] transition-transform hover:-translate-y-0.5"
      >
        {user ? 'Start writing' : 'Create your free account'}
      </a>
    </div>
  </section>

  <script src="../scripts/scroll-reveal.ts"></script>
</BaseLayout>
