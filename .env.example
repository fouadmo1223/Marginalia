# --- App ---
PUBLIC_SITE_URL=http://localhost:4321
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/blogs?retryWrites=true&w=majority

# --- Sessions / JWT ---
# Long random string, e.g. `openssl rand -hex 64`
SESSION_SECRET=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (transactional: verification / password reset) ---
# Provider-agnostic SMTP config. Leave blank in dev to log emails to console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Blogs <no-reply@example.com>"

# --- Bootstrap admin account (used only by `npm run bootstrap-admin`) ---
ADMIN_NAME="Site Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
